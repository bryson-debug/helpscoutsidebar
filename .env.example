# HelpScout Dynamic App (from HelpScout Developer / My Apps portal)
HELPSCOUT_APP_SECRET=
SESSION_TOKEN_SECRET=

# The app must only run on the "Tarbet Education Network" mailbox, never on
# "That Music Teacher, LLC" or any other mailbox. Prefer the numeric mailbox
# ID (stable) once known from the HelpScout app installation; name is a
# fallback and should be dropped once the ID is confirmed.
ALLOWED_MAILBOX_NAME=Tarbet Education Network
ALLOWED_MAILBOX_ID=

# Flodesk API (read + write scopes)
FLODESK_API_KEY=

# Google Sheets audit log
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
