# HelpScout Dynamic App (from HelpScout Developer / My Apps portal)
HELPSCOUT_APP_SECRET=
SESSION_TOKEN_SECRET=

# The app must only run on mailboxes it's explicitly enabled for. Multiple
# values are separated by `|` (not comma — mailbox names can contain commas).
# Prefer numeric mailbox IDs (stable, confirmed for both below); names are a
# fallback. Note the real mailbox name is "That Music Teacher" (no ", LLC").
ALLOWED_MAILBOX_NAME=Tarbet Education Network|That Music Teacher
ALLOWED_MAILBOX_ID=364558|317821

# Flodesk API (read + write scopes)
FLODESK_API_KEY=

# Google Sheets audit log
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
